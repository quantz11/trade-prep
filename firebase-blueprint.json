{
  "entities": {
    "TradingSession": {
      "title": "Trading Session",
      "description": "Stores trade pairs, parameters, and checklist state across sessions and devices",
      "type": "object",
      "properties": {
        "pairs": {
          "type": "string",
          "description": "JSON string of pairs sessions dictionary including pasted chart images",
          "maxLength": 10000000
        },
        "savedTrades": {
          "type": "string",
          "description": "JSON string of saved trades list",
          "maxLength": 10000000
        },
        "activeInstrument": {
          "type": "string",
          "description": "Currently active instrument key"
        },
        "password": {
          "type": "string",
          "description": "Workstation authentication password",
          "maxLength": 256
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp"
        }
      },
      "required": ["pairs", "savedTrades", "activeInstrument", "updatedAt"]
    }
  },
  "firestore": {
    "/sessions/{sessionId}": {
      "schema": {
        "$ref": "#/entities/TradingSession"
      },
      "description": "Global or user trading session state"
    }
  }
}
